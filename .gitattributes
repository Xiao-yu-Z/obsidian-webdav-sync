# 统一换行符，避免 Windows / macOS / Linux 混用时出现无谓的整文件 diff
* text=auto eol=lf

# 明确按文本处理的类型
*.ts      text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.css     text eol=lf
*.example text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制：禁止任何换行符/文本转换
*.zip    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.pem    binary
*.key    binary
*.p12    binary
*.pfx    binary
