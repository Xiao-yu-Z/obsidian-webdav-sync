# ---------- 依赖（构建期使用，不入库） ----------
node_modules/

# ---------- 真实凭据 / 密钥（切勿入库） ----------
.env
server/ssl/
*.pem
*.key
*.p12
*.pfx

# ---------- 个人调试产物 / 隐私数据 ----------
# idx2.json 是服务器索引快照（含全部笔记路径与 sha256 哈希），属于隐私，不要公开
idx2.json
# tools/work 是清理/备份时的临时缓存（含笔记路径），不要公开
tools/work/

# ---------- 日志与系统文件 ----------
*.log
.DS_Store
Thumbs.db
